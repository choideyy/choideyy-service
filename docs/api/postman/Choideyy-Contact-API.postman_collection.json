{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Choideyy Contact API",
    "description": "Manual/API test collection for POST /api/contact, docs, and error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "origin", "value": "http://localhost:5173" }
  ],
  "item": [
    {
      "name": "Successful request",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"Hello, I would like more information about Choideyy.\",\n  \"website\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Missing required field",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"Hello, I would like more information about Choideyy.\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Invalid email",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"not-an-email\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"Hello, I would like more information about Choideyy.\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Empty message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Message exceeding maximum length",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"{{messageTooLong}}\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('messageTooLong', 'M'.repeat(5001));"]
          }
        }
      ]
    },
    {
      "name": "Invalid Content-Type",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/plain" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "not-json"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Bot protection triggered (honeypot)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"Hello, I would like more information about Choideyy.\",\n  \"website\": \"http://spam-bot.example\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Bot protection triggered (too fast)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General enquiry\",\n  \"message\": \"Hello, I would like more information about Choideyy.\",\n  \"formStartedAt\": {{$timestamp}}000\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Rate limit exceeded",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{origin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"Rate limit probe\",\n  \"message\": \"Hello, this request is used to probe rate limiting behavior.\"\n}"
        },
        "url": "{{baseUrl}}/api/contact",
        "description": "Send 6+ times quickly from the same IP to observe HTTP 429."
      }
    },
    {
      "name": "Internal server error (mocked)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/docs",
        "description": "Cannot be triggered via a live SMTP call. Covered by automated Vitest route tests that mock sendContactEmail to throw. Expected JSON: {\"success\":false,\"error\":\"Internal server error\"}."
      }
    },
    {
      "name": "OpenAPI JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/openapi.json"
      }
    },
    {
      "name": "Swagger UI",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/docs"
      }
    }
  ]
}
