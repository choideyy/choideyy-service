  Origin: {{origin}}
}

body:json {
  {
    "name": "John Doe",
    "email": "john@example.com",
    "subject": "Rate limit probe",
    "message": "Hello, this request is used to probe rate limiting behavior."
  }
}

docs {
  Send 6+ times quickly from the same IP to observe HTTP 429.
}
