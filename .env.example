# SMTP (required) — never commit real credentials
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=<16-char App Password — NOT your normal Google password>
#
# Create an App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Open https://myaccount.google.com/apppasswords
#   3. Generate a Mail app password and paste it below (spaces are OK)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Fixed recipient for Contact Us emails (required)
CONTACT_RECEIVER_EMAIL=hello@choideyy.com

# Frontend origin(s) allowed for CORS (comma-separated for multiple)
# Example: https://choideyy.com,https://www.choideyy.com,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
